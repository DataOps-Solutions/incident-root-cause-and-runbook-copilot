# LLM provider: "mock" (local, deterministic, no AWS) or "bedrock"
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS credentials are resolved by the standard boto3 chain (AWS_PROFILE or IAM role).
# Never commit real credentials.
